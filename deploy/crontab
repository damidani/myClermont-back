# crontab -u www-data deploy/crontab
# Purge des nonces / compteurs expirés (mode MySQL) et des refresh tokens périmés
*/15 * * * * php /var/www/myclermont/bin/console cache:prune > /dev/null 2>&1
# Transmission des demandes de contact logement aux annonceurs
* * * * * php /var/www/myclermont/bin/console housing:send-contacts > /dev/null 2>&1
# Transmission des candidatures (CV joints) et maintenance emploi / RGPD
* * * * * php /var/www/myclermont/bin/console jobs:send-applications > /dev/null 2>&1
30 * * * * php /var/www/myclermont/bin/console jobs:maintenance > /dev/null 2>&1
# Demandes de devis, médias non publiés
* * * * * php /var/www/myclermont/bin/console services:send-quotes > /dev/null 2>&1
45 * * * * php /var/www/myclermont/bin/console media:purge > /dev/null 2>&1
# Notifications push (nouveaux messages) et expiration des petites annonces
* * * * * php /var/www/myclermont/bin/console push:send > /dev/null 2>&1
15 * * * * php /var/www/myclermont/bin/console classifieds:maintenance > /dev/null 2>&1
# Imports automatiques : chaque source à sa fréquence (config/imports.php › every)
*/5 * * * * php /var/www/myclermont/bin/console import:all >> /var/www/myclermont/storage/logs/imports.log 2>&1
# Rotation des logs applicatifs : conserve 30 jours
0 3 * * * find /var/www/myclermont/storage/logs -name 'app-*.log' -mtime +30 -delete
# Comptes supprimés depuis 30 jours : effacement (spec v1 › DELETE /me)
20 4 * * * php /var/www/myclermont/bin/console account:purge > /dev/null 2>&1
50 3 * * * php /var/www/myclermont/bin/console events:maintenance > /dev/null 2>&1
45 * * * * php /var/www/myclermont/bin/console uploads:purge > /dev/null 2>&1
*/5 * * * * php /var/www/myclermont/bin/console push:topics > /dev/null 2>&1
10 4 * * * php /var/www/myclermont/bin/console rgpd:purge > /dev/null 2>&1

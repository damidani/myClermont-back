# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_ENV=production            # production | local
APP_DEBUG=false               # true = messages d'erreur détaillés (JAMAIS en production)
APP_TIMEZONE=UTC

# Clé maître (32 octets base64) qui chiffre les secrets appareils en base.
# Générer avec : php bin/console key:generate
APP_KEY=

# ---------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myclermont
DB_USERNAME=myclermont
DB_PASSWORD=
DB_PERSISTENT=true            # connexions persistantes PHP-FPM (évite le handshake à chaque requête)

# ---------------------------------------------------------------
# Sécurité : signature des requêtes
# ---------------------------------------------------------------
# Clés "application" embarquées dans les apps, utilisées UNIQUEMENT pour
# l'enregistrement d'un appareil. Format : keyId:plateforme:secretBase64, séparés par des virgules.
# Plusieurs clés par plateforme = rotation sans casser les anciennes versions de l'app.
APP_SIGNING_KEYS="ios-2026-1:ios:CHANGE_ME,android-2026-1:android:CHANGE_ME"

SIGNATURE_WINDOW=300          # tolérance d'horloge en secondes (± 5 min)

# ---------------------------------------------------------------
# Sécurité : jetons utilisateur
# ---------------------------------------------------------------
JWT_SECRET=                   # 64 octets base64, généré par key:generate
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=5184000       # 60 jours (spec v1)
JWT_ISSUER=api.myclermont.app

# ---------------------------------------------------------------
# Limitation de débit (requêtes / fenêtre en secondes)
# ---------------------------------------------------------------
RATE_LIMIT_DEVICE=120,60
RATE_LIMIT_REGISTER=10,3600
RATE_LIMIT_LOGIN=10,60
RATE_LIMIT_CONTACT=10,3600     # formulaires « Contacter l'annonceur »

# ---------------------------------------------------------------
# Proxy / load balancer : IP de confiance (séparées par des virgules)
# ---------------------------------------------------------------
TRUSTED_PROXIES=

# Cache : apcu | mysql (auto = apcu si l'extension est active, sinon mysql)
CACHE_DRIVER=auto

# E-mails (demandes de contact transmises aux annonceurs)
MAIL_FROM=no-reply@myclermont.app
HOUSING_CONTACT_FALLBACK_EMAIL=

# Liens de partage
EVENTS_SHARE_URL=https://myclermont.app/agenda/{slug}
HOUSING_SHARE_URL=https://myclermont.app/logement/{id}

# Taille maximale du corps de requête (octets)
MAX_BODY_SIZE=1048576
MAX_UPLOAD_SIZE=5242880        # CV / lettres de motivation (PDF), 5 Mo
MAX_MEDIA_SIZE=62914560        # photos (10 Mo max) et vidéos (60 Mo, spec v1)
APP_URL=https://api.myclermont.app  # adresse publique (URL d'envoi des fichiers)
MEDIA_BASE_URL=https://api.myclermont.app/media

# Mobilité : API Navitia (transports en commun T2C)
NAVITIA_TOKEN=
NAVITIA_COVERAGE=fr-se          # à vérifier dans la console Navitia
NAVITIA_NETWORK_ID=             # réseau T2C pour l'info trafic (ex. network:…)

# Candidatures : destinataire si l'offre n'a pas d'e-mail recruteur
JOBS_APPLICATION_FALLBACK_EMAIL=
JOBS_SHARE_URL=https://myclermont.app/emploi/{id}

# Services : destinataire des demandes de devis si la fiche n'a pas d'e-mail
SERVICES_QUOTE_FALLBACK_EMAIL=
SERVICES_SHARE_URL=https://myclermont.app/services/{id}
COMMUNITY_SHARE_URL=https://myclermont.app/communaute/{id}
CLASSIFIEDS_SHARE_URL=https://myclermont.app/annonces/{id}
PLACES_SHARE_URL=https://myclermont.app/lieux/{id}

# ---------------------------------------------------------------
# Back-office web (/admin) — comptes : php bin/console admin:create
# ---------------------------------------------------------------
ADMIN_ENABLED=true
ADMIN_ALLOWED_IPS=            # ex. "1.2.3.4,5.6.7.8" (vide = toutes les IP)
ADMIN_REQUIRE_2FA=true        # double authentification obligatoire pour tous les admins
ADMIN_SESSION_TTL=28800       # durée max d'une session (s)
ADMIN_IDLE_TIMEOUT=3600       # déconnexion après inactivité (s)

# ---------------------------------------------------------------
# Imports automatiques (config/imports.php, docs/IMPORTS.md)
# ---------------------------------------------------------------
# Offres d'emploi France Travail : créer une application gratuite sur https://francetravail.io
# et l'abonner à l'API « Offres d'emploi v2 ». Vide = import désactivé.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_COMMUNE=63113  # code INSEE (63113 = Clermont-Ferrand)
FRANCE_TRAVAIL_DISTANCE=15    # rayon en km
GEOCODER_URL=https://data.geopf.fr/geocodage/search
# Agrégateurs d'offres d'emploi (vide = désactivé) : https://developer.adzuna.com et https://jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# ---------------------------------------------------------------
# Connexion Apple / Google (config/auth.php)
# ---------------------------------------------------------------
APPLE_BUNDLE_ID=com.myclermont.app
APPLE_TEAM_ID=MQJ3CCT2BL
APPLE_KEY_ID=                 # clé « Sign in with Apple » créée dans le compte développeur
APPLE_PRIVATE_KEY=            # contenu du fichier .p8 (sauts de ligne remplacés par \n)
GOOGLE_CLIENT_IDS=            # identifiants client OAuth iOS et Android (audiences acceptées), séparés par des virgules

# Info trafic routier (spec v1 › Trafic) : clé TomTom (vide = 503 not_configured)
TOMTOM_API_KEY=
TRAFFIC_CACHE_SECONDS=300

# ---------------------------------------------------------------
# Clermont IA (config/assistant.php) — vide = 503 not_configured, l'app garde son moteur local
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_FREE_QUESTIONS=1
ASSISTANT_PLUS_DAILY=100

# Notifications (config/push.php) : clé APNs .p8 et compte de service Firebase
APNS_KEY_ID=
APNS_TEAM_ID=MQJ3CCT2BL
APNS_KEY=
APNS_SANDBOX=false
FCM_SERVICE_ACCOUNT=

# My Clermont+ (StoreKit 2, config/subscriptions.php)
APPLE_APP_APPLE_ID=

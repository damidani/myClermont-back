# Variables du docker-compose.yml. Copier en .env.docker et CHANGER les mots de passe.
# Toutes les variables de .env.example sont utilisables ici (elles sont recopiées dans le .env du conteneur).
# Les clés APP_KEY / JWT_SECRET / APP_SIGNING_KEYS sont générées au premier démarrage
# (voir `docker compose logs web` pour les clés iOS / Android) et conservées dans le volume "storage".

APP_ENV=production            # "local" = code relu à chaque requête, erreurs détaillées possibles
APP_DEBUG=false

# Base de données (le conteneur MariaDB est créé avec ces identifiants)
DB_DATABASE=myclermont
DB_USERNAME=myclermont
DB_PASSWORD=change-moi-db
MARIADB_DATABASE=myclermont
MARIADB_USER=myclermont
MARIADB_PASSWORD=change-moi-db
MARIADB_ROOT_PASSWORD=change-moi-root

# Compte du back-office créé au premier démarrage (si aucun admin n'existe)
ADMIN_EMAIL=admin@myclermont.fr
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-moi-admin-12c
ADMIN_REQUIRE_2FA=true

# Données de démonstration (agenda, lieux, annonces…) au premier démarrage
DEMO_DATA=false

# URL publique (photos / vidéos)
MEDIA_BASE_URL=http://localhost:8080/media

# Envoi d'emails (laisser SMTP_HOST vide pour désactiver)
MAIL_FROM=no-reply@myclermont.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Nombre de workers PHP (~30 Mo de RAM chacun)
PHP_FPM_MAX_CHILDREN=16

{
    "name": "myclermont/api",
    "description": "Backend API PHP/MySQL des applications mobiles myClermont (iOS & Android)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*"
    },
    "suggest": {
        "ext-apcu": "Stockage en mémoire des nonces, du rate-limit et du cache appareils (fortement recommandé en production)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
    }
}

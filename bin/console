                    'price' => $price, 'surface' => (string) $surface, 'rooms' => $rooms, 'bedrooms' => $bedrooms, 'furnished' => $furnished,
                    'features' => $features, 'district' => $district, 'hood' => $hood($hoodSlug), 'lat' => (string) $lat, 'lng' => (string) $lng,
                    'caption' => 'Photos d\'illustration · démo', 'notice' => 'Annonce fictive : aucune prise de contact réelle.',
                    'p' => $now, 'c' => $now, 'u' => $now,
                ],
            );
            foreach ([1, 2, 3] as $pos) {
                Database::execute('INSERT INTO housing_images (listing_id, url, position) VALUES (:l, :u, :p)',
                    ['l' => $id, 'u' => "https://picsum.photos/seed/myclermont-{$i}-{$pos}/1200/800", 'p' => $pos]);
            }
        }
        (new \App\Modules\Housing\HousingRepository())->forgetCounts();
        $out(count($demo) . ' annonces de démo créées (2 locations, 2 ventes, 1 colocation).');
        break;

    case 'events:seed-demo':
        // Crée des événements fictifs relatifs à aujourd'hui (pour développer l'app)
        $tz = new DateTimeZone('Europe/Paris');
        $cat = array_column(Database::fetchAll('SELECT id, slug FROM event_categories'), 'id', 'slug');
        $demo = [
            ['sport', 'Match de rugby — soirée supporters', 1, '19:00', 120, 'Stade Marcel-Michelin', '107 Avenue de la République', 45.7899, 3.1162, 'Billetterie à confirmer', null,
             "Une soirée autour du rugby clermontois.\nÉvénement fictif utilisé pour tester l'agenda.", [['18:00', 'Accueil du public'], ['19:00', 'Animation sportive'], ['21:00', 'Fin prévisionnelle']], ''],
            ['musique', 'Concert au cœur de Clermont', 2, '20:00', 150, 'Centre-ville', 'Place de Jaude', 45.7772, 3.0820, 'À partir de 15 € · démo', 1500,
             'Concert en plein air place de Jaude.', [['19:30', 'Ouverture des portes'], ['20:00', 'Première partie'], ['21:00', 'Concert']], ''],
            ['nature', 'Lever de soleil au sommet du puy de Dôme', 3, '06:30', 180, 'Puy de Dôme', 'Orcines', 45.7726, 2.9644, 'Gratuit', 0,
             'Randonnée guidée jusqu\'au sommet.', [['06:30', 'Départ du col de Ceyssat'], ['07:45', 'Lever de soleil']], 'volcan'],
            ['gastronomie', 'Marché des producteurs auvergnats', 4, '09:00', 240, 'Place Saint-Pierre', null, 45.7797, 3.0864, 'Entrée libre', 0,
             'Fromages AOP, charcuterie et produits locaux.', [], 'gourmand'],
            ['culture', 'Visite nocturne de la cathédrale', 5, '21:00', 90, 'Cathédrale Notre-Dame-de-l\'Assomption', 'Place de la Victoire', 45.7786, 3.0864, '8 € · démo', 800,
             'Découverte de la cathédrale de pierre de Volvic à la lanterne.', [], 'volcan'],
            ['famille', 'Après-midi jeux au jardin Lecoq', 6, '14:00', 180, 'Jardin Lecoq', null, 45.7720, 3.0890, 'Gratuit', 0,
             'Jeux en bois et ateliers pour enfants.', [], ''],
            ['sport', 'Course des volcans', 8, '09:30', 150, 'Vulcania', 'Saint-Ours', 45.8142, 2.9420, 'À partir de 12 € · démo', 1200,
             'Trail de 15 km entre les volcans.', [['08:30', 'Retrait des dossards'], ['09:30', 'Départ']], 'volcan'],
        ];
        $now = gmdate('Y-m-d H:i:s');
        foreach ($demo as $i => [$c, $title, $inDays, $time, $minutes, $venue, $address, $lat, $lng, $priceLabel, $priceCents, $desc, $programme, $tags]) {
            $start = (new DateTimeImmutable("today +{$inDays} days {$time}", $tz))->setTimezone(new DateTimeZone('UTC'));
            $slug = 'demo-' . ($i + 1) . '-' . trim(preg_replace('/[^a-z0-9]+/', '-', strtolower(iconv('UTF-8', 'ASCII//TRANSLIT', $title))), '-');
            Database::execute('DELETE FROM events WHERE slug = :s', ['s' => $slug]);
            $id = Database::insert(
                'INSERT INTO events (uid, slug, category_id, title, description, image_url, image_caption, starts_at, ends_at, venue_name, city, address,
                                     latitude, longitude, price_label, price_min_cents, tags, notice, status, is_featured, created_at, updated_at)
                 VALUES (:uid, :slug, :cat, :title, :descr, NULL, :caption, :start, :end, :venue, \'Clermont-Ferrand\', :address,
                         :lat, :lng, :plabel, :pcents, :tags, :notice, \'published\', :featured, :c, :u)',
                [
                    'uid' => \App\Security\Crypto::uuid4(), 'slug' => $slug, 'cat' => $cat[$c], 'title' => $title, 'descr' => $desc,
                    'caption' => 'Visuel d\'illustration · démo', 'start' => $start->format('Y-m-d H:i:s'),
                    'end' => $start->modify("+{$minutes} minutes")->format('Y-m-d H:i:s'), 'venue' => $venue, 'address' => $address,
                    'lat' => (string) $lat, 'lng' => (string) $lng, 'plabel' => $priceLabel, 'pcents' => $priceCents, 'tags' => $tags ?: null,
                    'notice' => 'Événement fictif : aucune réservation ni billetterie réelle.', 'featured' => $i === 0 ? 1 : 0, 'c' => $now, 'u' => $now,
                ],
            );
            foreach ($programme as $pos => [$t, $label]) {
                Database::execute('INSERT INTO event_schedule_items (event_id, time, label, position) VALUES (:e, :t, :l, :p)', ['e' => $id, 't' => $t, 'l' => $label, 'p' => $pos]);
            }
        }
        $out(count($demo) . ' événements de démo créés (slug demo-*). Relancer la commande les recrée à partir d\'aujourd\'hui.');
        break;

    case 'sign':
        /*
         * Génère une commande curl signée pour tester l'API à la main.
         *   Appareil : php bin/console sign GET /v1/devices/me --device-id=… --token=… --secret=…
         *   Clé app  : php bin/console sign POST /v1/devices/register '{"platform":"ios"}' --key-id=ios-2026-1 --device-id=…
         */
        [$method, $target, $body] = $positional + [null, null, ''];
        if (!$method || !$target) {
            $fail('Usage : php bin/console sign <METHOD> <path?query> [body] --device-id=… (--token=… --secret=… | --key-id=…) [--base=https://…]');
        }
        $deviceId = (string) ($options['device-id'] ?? $fail('--device-id requis'));
        [$path, $query] = array_pad(explode('?', $target, 2), 2, '');
        $timestamp = (string) time();
        $nonce = bin2hex(random_bytes(16));

        if (isset($options['key-id'])) {
            $key = Config::get('security.app_keys.' . $options['key-id']) ?? $fail('keyId inconnu');
            $secret = $key['secret'];
            $headers = ['X-Key-Id' => $options['key-id']];
        } else {
            $secret = (string) ($options['secret'] ?? $fail('--secret requis'));
            $headers = ['X-Device-Token' => (string) ($options['token'] ?? $fail('--token requis'))];
            if (isset($options['bearer'])) {
                $headers['Authorization'] = 'Bearer ' . $options['bearer'];
            }
        }

        $signature = Signature::sign($secret, Signature::stringToSign($method, $path, $query, $timestamp, $nonce, $deviceId, $body));
        $headers += ['X-Device-Id' => $deviceId, 'X-Timestamp' => $timestamp, 'X-Nonce' => $nonce, 'X-Signature' => $signature];

        $base = rtrim((string) ($options['base'] ?? 'http://127.0.0.1:8080'), '/');
        $cmd = 'curl -sS -X ' . strtoupper($method) . ' ' . escapeshellarg($base . $target);
        foreach ($headers as $name => $value) {
            $cmd .= " \\\n  -H " . escapeshellarg("{$name}: {$value}");
        }
        if ($body !== '') {
            $cmd .= " \\\n  -H 'Content-Type: application/json' --data-raw " . escapeshellarg($body);
        }
        $out($cmd);
        break;

    default:
        $out(<<<TXT
        Commandes disponibles :
          key:generate [--force]           Génère APP_KEY, JWT_SECRET et les clés application
          app-key:add <ios|android> <id>   Ajoute une clé application (rotation)
          migrate                          Exécute les migrations SQL en attente
          config:cache                     Compile la configuration (production)
          config:clear                     Supprime le cache de configuration
          cache:prune                      Purge les entrées expirées (à mettre en cron)
          admin:create <email> "<Nom>"     Crée / réinitialise un compte du back-office [--role=admin|editor|moderator]
          device:block <device-id>         Bloque un appareil et révoque ses sessions
          device:unblock <device-id>       Débloque un appareil
          premium:grant <email> <jours>    Attribue / prolonge le premium [--source=admin]
          premium:revoke <email>           Retire le premium
          gamification:recheck [email]     Réévalue les badges (après changement de seuils)
          events:seed-demo                 Crée 7 événements fictifs (développement)
          housing:seed-demo                Crée 5 annonces fictives (développement)
          housing:send-contacts            Transmet les demandes de contact par e-mail (cron)
          jobs:seed-demo                   Crée 4 offres d'emploi fictives (développement)
          jobs:send-applications           Transmet les candidatures (CV en pièce jointe) par e-mail (cron)
          jobs:maintenance                 Archive les offres expirées, supprime les CV périmés (cron)
          services:seed-demo               Crée 4 professionnels fictifs (développement)
          services:send-quotes             Transmet les demandes de devis par e-mail (cron)
          community:seed-demo              Crée 2 publications fictives (développement)
          community:moderation [--restore=<id>|--delete=<id>]   Publications masquées après signalements
          media:purge                      Supprime les photos / vidéos jamais publiées (cron)
          classifieds:seed-demo            Crée 4 petites annonces fictives (développement)
          classifieds:maintenance          Passe en « expirée » les annonces arrivées à échéance (cron)
          push:send                        Envoie les notifications push en attente (cron)
          explore:seed-demo                Crée le contenu de démo de l'écran Explorer
          places:seed-demo                 Crée des lieux de démo (fiche Place de Jaude + repères)
          source:add <slug> <nom> <partner|import> [--contact=…] [--auto-publish]   Déclare une source de contenu
          import:run <slug> | import:all [--force]   Lance un import (import:all : seulement les sources dues)
          api:call <METHODE> <chemin> [json] [--base=URL] [--token=…]   Appel signé de l'API (outil de développement)
          account:purge                    Efface les comptes supprimés depuis plus de 30 jours (cron quotidien)
          import:status                    État des sources importées (dernier passage, résultat)
          import:preview <slug> [n]        Affiche les n premiers éléments récupérés, sans rien enregistrer
          sign <METHOD> <path> [body] …    Génère une commande curl signée (tests)
        TXT);
}

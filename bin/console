    case 'community:moderation':
        // Publications masquées après signalements : php bin/console community:moderation [--restore=<uid>|--delete=<uid>]
        if (isset($options['restore'])) {
            Database::execute("UPDATE community_posts SET status = 'visible', reports_count = 0 WHERE uid = :u AND status = 'hidden'", ['u' => $options['restore']]);
            $out('Publication rétablie.');
            break;
        }
        if (isset($options['delete'])) {
            $post = Database::fetch('SELECT id FROM community_posts WHERE uid = :u', ['u' => $options['delete']]) ?? $fail('Publication introuvable.');
            (new \App\Modules\Community\PostRepository())->delete((int) $post['id']);
            $out('Publication supprimée.');
            break;
        }
        foreach (Database::fetchAll("SELECT p.uid, p.type, p.reports_count, LEFT(p.body, 80) AS excerpt, u.username FROM community_posts p JOIN users u ON u.id = p.user_id WHERE p.status = 'hidden' ORDER BY p.id DESC LIMIT 50") as $p) {
            $out("{$p['uid']}  [{$p['type']}] {$p['reports_count']} signalement(s)  @{$p['username']} : {$p['excerpt']}");
        }
        break;


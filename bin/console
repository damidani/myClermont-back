#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Outils en ligne de commande.  Usage : php bin/console <commande> [options]
 */

use App\Cache\MysqlStore;
use App\Content\Import\ImportRunner;
use App\Modules\Housing\ContactDispatcher;
use App\Core\App;
use App\Core\Config;
use App\Core\Database;
use App\Modules\Account\Repositories\UserRepository;
use App\Modules\Gamification\GamificationService;
use App\Modules\Premium\PremiumService;
use App\Repositories\DeviceRepository;
use App\Repositories\RefreshTokenRepository;
use App\Security\Signature;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

$args = array_slice($argv, 1);
$command = array_shift($args) ?? 'help';
$options = [];
$positional = [];
foreach ($args as $arg) {
    if (preg_match('/^--([\w-]+)(?:=(.*))?$/s', $arg, $m)) {
        $options[$m[1]] = $m[2] ?? true;
    } else {
        $positional[] = $arg;
    }
}

$out = static fn (string $line = '') => fwrite(STDOUT, $line . PHP_EOL);
$fail = static function (string $message): never {
    fwrite(STDERR, "\033[31m{$message}\033[0m" . PHP_EOL);
    exit(1);
};

/** Remplace (ou ajoute) une variable dans .env */
$setEnv = static function (string $file, string $key, string $value): void {
    $content = is_file($file) ? (string) file_get_contents($file) : '';
    $line = $key . '=' . $value;
    $pattern = '/^' . preg_quote($key, '/') . '=.*$/m';
    $content = preg_match($pattern, $content)
        ? preg_replace_callback($pattern, static fn () => $line, $content)
        : rtrim($content) . PHP_EOL . $line . PHP_EOL;
    file_put_contents($file, $content);
};

// Les commandes de configuration doivent lire le .env, jamais le cache
if (!in_array($command, ['key:generate', 'config:clear', 'help'], true)) {
    Config::load($root);
    App::bootModules();
}

$findUser = static function (?string $email) use ($fail): array {
    return ($email ? (new UserRepository())->findByEmail($email) : null) ?? $fail('Utilisateur introuvable : ' . $email);
};

switch ($command) {
    case 'key:generate':
        $env = $root . '/.env';
        if (!is_file($env)) {
            copy($root . '/.env.example', $env);
            $out('.env créé depuis .env.example');
        }
        $current = (string) file_get_contents($env);
        $force = isset($options['force']);

        if ($force || preg_match('/^APP_KEY=\s*(#.*)?$/m', $current)) {
            $setEnv($env, 'APP_KEY', base64_encode(random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES)));
            $out('APP_KEY générée.');
            if ($force) {
                $out("\033[33mATTENTION : les secrets appareils existants deviennent illisibles, tous les appareils devront se réenregistrer.\033[0m");
            }
        }
        if ($force || preg_match('/^JWT_SECRET=\s*(#.*)?$/m', $current)) {
            $setEnv($env, 'JWT_SECRET', base64_encode(random_bytes(64)));
            $out('JWT_SECRET généré.');
        }
        if ($force || str_contains($current, 'CHANGE_ME')) {
            $year = date('Y');
            $ios = base64_encode(random_bytes(32));
            $android = base64_encode(random_bytes(32));
            $setEnv($env, 'APP_SIGNING_KEYS', "\"ios-{$year}-1:ios:{$ios},android-{$year}-1:android:{$android}\"");
            $out('Clés application générées (à intégrer dans les apps) :');
            $out("  iOS     : keyId=ios-{$year}-1      secret={$ios}");
            $out("  Android : keyId=android-{$year}-1  secret={$android}");
        }
        $out('Terminé. Pensez à relancer `php bin/console config:cache` en production.');
        break;

    case 'app-key:add':
        // php bin/console app-key:add ios ios-2027-1  => ajoute une clé (rotation)
        [$platform, $keyId] = $positional + [null, null];
        if (!in_array($platform, ['ios', 'android'], true) || !$keyId) {
            $fail('Usage : php bin/console app-key:add <ios|android> <keyId>');
        }
        $secret = base64_encode(random_bytes(32));
        $env = $root . '/.env';
        preg_match('/^APP_SIGNING_KEYS="?([^"\n]*)"?$/m', (string) file_get_contents($env), $m);
        $keys = array_filter(explode(',', $m[1] ?? ''));
        $keys[] = "{$keyId}:{$platform}:{$secret}";
        $setEnv($env, 'APP_SIGNING_KEYS', '"' . implode(',', $keys) . '"');
        $out("Clé ajoutée : keyId={$keyId} secret={$secret}");
        $out('Pour révoquer une ancienne clé, supprimez-la de APP_SIGNING_KEYS dans .env.');
        break;

    case 'migrate':
        $pdo = Database::connection();
        $pdo->exec('CREATE TABLE IF NOT EXISTS migrations (name VARCHAR(191) PRIMARY KEY, ran_at DATETIME NOT NULL) ENGINE=InnoDB');
        $done = array_column(Database::fetchAll('SELECT name FROM migrations'), 'name');
        $files = glob($root . '/database/migrations/*.sql') ?: [];
        sort($files);
        $count = 0;
        foreach ($files as $file) {
            $name = basename($file);
            if (in_array($name, $done, true)) {
                continue;
            }
            $out("Migration : {$name}");
            $pdo->exec((string) file_get_contents($file));
            Database::execute('INSERT INTO migrations (name, ran_at) VALUES (:n, :d)', ['n' => $name, 'd' => gmdate('Y-m-d H:i:s')]);
            $count++;
        }
        \App\Admin\Schema::forget(); // le back-office relit le schéma
        $out($count ? "{$count} migration(s) exécutée(s)." : 'Base déjà à jour.');
        break;

    case 'config:cache':
        @unlink($root . '/storage/cache/config.php');
        Config::load($root);
        $export = '<?php return ' . var_export(Config::all(), true) . ';' . PHP_EOL;
        file_put_contents($root . '/storage/cache/config.php', $export, LOCK_EX);
        chmod($root . '/storage/cache/config.php', 0640);
        $out('Configuration mise en cache (storage/cache/config.php). Rechargez PHP-FPM.');
        break;

    case 'config:clear':
        @unlink($root . '/storage/cache/config.php');
        $out('Cache de configuration supprimé.');
        break;

    case 'api:call':
        // Outil de développement : appelle l'API comme l'app (appareil enregistré, requêtes signées).
        //   php bin/console api:call GET /v1/me [corps JSON] [--base=http://127.0.0.1] [--token=<accessToken>]
        $method = strtoupper($positional[0] ?? $fail('Usage : php bin/console api:call <METHODE> <chemin> [json] [--base=URL] [--token=…]'));
        $path = (string) ($positional[1] ?? $fail('Chemin manquant'));
        $body = (string) ($positional[2] ?? '');
        $base = rtrim((string) ($options['base'] ?? 'http://127.0.0.1'), '/');
        $stateFile = dirname(__DIR__) . '/storage/dev-device.json';
        $sign = static function (string $m, string $p, string $b, string $secret, string $uid) {
            [$path, $query] = array_pad(explode('?', $p, 2), 2, '');
            $ts = (string) time();
            $nonce = bin2hex(random_bytes(16));
            return [$ts, $nonce, \App\Security\Signature::sign($secret, \App\Security\Signature::stringToSign($m, $path, $query, $ts, $nonce, $uid, $b))];
        };
        $http = static function (string $m, string $url, array $headers, string $b) {
            $ch = curl_init($url);
            curl_setopt_array($ch, [CURLOPT_CUSTOMREQUEST => $m, CURLOPT_RETURNTRANSFER => true, CURLOPT_HTTPHEADER => $headers,
                                    CURLOPT_POSTFIELDS => $b === '' ? null : $b, CURLOPT_HEADER => false]);
            $res = (string) curl_exec($ch);
            return [(int) curl_getinfo($ch, CURLINFO_RESPONSE_CODE), $res];
        };
        $state = is_file($stateFile) ? json_decode((string) file_get_contents($stateFile), true) : null;
        if (!is_array($state) || ($state['base'] ?? null) !== $base) {
            $keys = (array) Config::get('security.app_keys');
            $keyId = (string) array_key_first($keys) ?: $fail('Aucune clé application (APP_SIGNING_KEYS).');
            $uid = \App\Security\Crypto::uuid4();
            $reg = json_encode(['platform' => $keys[$keyId]['platform'], 'model' => 'console', 'app_version' => 'dev']);
            [$ts, $nonce, $sig] = $sign('POST', '/v1/devices/register', $reg, $keys[$keyId]['secret'], $uid);
            [$code, $res] = $http('POST', $base . '/v1/devices/register', ['Content-Type: application/json', "X-Key-Id: {$keyId}", "X-Device-Id: {$uid}",
                                   "X-Timestamp: {$ts}", "X-Nonce: {$nonce}", "X-Signature: {$sig}"], $reg);
            $d = json_decode($res, true);
            if ($code >= 300 || empty($d['deviceSecret'])) {
                $fail("Enregistrement de l'appareil refusé ({$code}) : {$res}");
            }
            $state = ['base' => $base, 'uid' => $uid, 'token' => $d['deviceToken'], 'secret' => $d['deviceSecret']];
            file_put_contents($stateFile, json_encode($state));
            chmod($stateFile, 0600);
        }
        [$ts, $nonce, $sig] = $sign($method, $path, $body, $state['secret'], $state['uid']);
        $headers = ['Content-Type: application/json', 'X-Platform: ios', "X-Device-Id: {$state['uid']}", "X-Device-Token: {$state['token']}",
                    "X-Timestamp: {$ts}", "X-Nonce: {$nonce}", "X-Signature: {$sig}"];
        if (isset($options['token'])) {
            $headers[] = 'Authorization: Bearer ' . $options['token'];
        }
        [$code, $res] = $http($method, $base . $path, $headers, $body);
        $out("HTTP {$code}");
        $decoded = json_decode($res, true);
        $out($decoded !== null ? json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) : $res);
        exit($code >= 400 ? 1 : 0);

    case 'account:purge':
        // Spec v1 › DELETE /me : effacement 30 jours après la demande. Le compte est anonymisé (et non supprimé)
        // pour que ses posts et commentaires restent visibles sous « Compte supprimé ».
        $days = (int) Config::get('auth.deletion_days', 30);
        $rows = Database::fetchAll(
            "SELECT id, apple_refresh_encrypted FROM users WHERE status = 'deleted' AND deleted_at < :d AND (email IS NOT NULL OR apple_sub IS NOT NULL OR google_sub IS NOT NULL OR display_name IS NOT NULL)",
            ['d' => gmdate('Y-m-d H:i:s', time() - $days * 86400)],
        );
        foreach ($rows as $u) {
            if ($u['apple_refresh_encrypted']) {
                try {
                    (new \App\Security\AppleClient())->revoke(\App\Security\Crypto::decrypt($u['apple_refresh_encrypted']));
                } catch (Throwable) {
                }
            }
            Database::transaction(static function () use ($u): void {
                $id = (int) $u['id'];
                foreach (['favorites', 'documents', 'classifieds', 'point_transactions', 'user_badges', 'user_events', 'user_stats', 'push_outbox', 'refresh_tokens', 'event_participants'] as $table) {
                    try {
                        Database::execute("DELETE FROM {$table} WHERE user_id = :u", ['u' => $id]);
                    } catch (PDOException) {
                        // table absente selon les modules activés
                    }
                }
                Database::execute(
                    "UPDATE users SET email = NULL, password_hash = NULL, display_name = NULL, bio = NULL, neighborhood_id = NULL,
                            avatar_kind = 'symbol', avatar_value = 'person.crop.circle.fill', apple_sub = NULL, google_sub = NULL,
                            apple_refresh_encrypted = NULL, premium_until = NULL, referral_code = NULL, points = 0, updated_at = :d WHERE id = :id",
                    ['d' => gmdate('Y-m-d H:i:s'), 'id' => $id],
                );
            });
        }
        $out('Comptes effacés : ' . count($rows));
        break;

    case 'cache:prune':
        $out('Entrées de cache expirées supprimées : ' . MysqlStore::prune());
        $out('Refresh tokens expirés supprimés : ' . RefreshTokenRepository::prune());
        break;

    case 'admin:create':
        // Crée (ou réinitialise) un compte du back-office web /admin
        [$email, $name] = [mb_strtolower(trim((string) ($positional[0] ?? ''))), trim((string) ($positional[1] ?? ''))];
        $role = (string) ($options['role'] ?? 'admin');
        if (!filter_var($email, FILTER_VALIDATE_EMAIL) || $name === '' || !in_array($role, ['admin', 'editor', 'moderator'], true)) {
            $fail('Usage : php bin/console admin:create <email> "<Nom>" [--role=admin|editor|moderator]');
        }
        $password = getenv('ADMIN_PASSWORD') ?: null;
        if ($password === null) {
            fwrite(STDOUT, 'Mot de passe (12 caractères min.) : ');
            system('stty -echo 2>/dev/null');
            $password = trim((string) fgets(STDIN));
            system('stty echo 2>/dev/null');
            $out();
        }
        mb_strlen($password) >= 12 || $fail('12 caractères minimum.');
        $now = gmdate('Y-m-d H:i:s');
        Database::execute(
            "INSERT INTO admin_users (email, name, password_hash, role, status, created_at, updated_at) VALUES (:e, :n, :h, :r, 'active', :d, :d)
             ON DUPLICATE KEY UPDATE name = VALUES(name), password_hash = VALUES(password_hash), role = VALUES(role), status = 'active', updated_at = VALUES(updated_at)",
            ['e' => $email, 'n' => $name, 'h' => password_hash($password, PASSWORD_ARGON2ID), 'r' => $role, 'd' => $now],
        );
        $out("Administrateur {$email} ({$role}) prêt. Connexion : https://<votre-domaine>/admin");
        break;

    case 'device:block':
    case 'device:unblock':
        $uid = strtolower((string) ($positional[0] ?? ''));
        if ($uid === '') {
            $fail("Usage : php bin/console {$command} <device-id>");
        }
        $repo = new DeviceRepository();
        $repo->setStatus($uid, $command === 'device:block' ? 'blocked' : 'active') || $fail('Appareil introuvable ou déjà dans cet état.');
        if ($command === 'device:block' && ($device = $repo->findByUid($uid, true))) {
            (new RefreshTokenRepository())->revokeAllForDevice((int) $device['id']);
        }
        $out($command === 'device:block' ? "Appareil {$uid} bloqué, sessions révoquées." : "Appareil {$uid} débloqué.");
        $out('Note : avec APCu, lancer cette commande ne vide pas le cache de PHP-FPM ; il expire seul en ' . Config::get('security.device_cache_ttl') . ' s.');
        break;

    case 'premium:grant':
        // php bin/console premium:grant lea@example.fr 30 [--source=promo]
        $user = $findUser($positional[0] ?? null);
        $days = (int) ($positional[1] ?? 0);
        $days > 0 || $fail('Usage : php bin/console premium:grant <email> <jours> [--source=admin]');
        $until = (new PremiumService())->grant((int) $user['id'], $days, (string) ($options['source'] ?? 'admin'));
        $out("Premium actif pour {$user['username']} jusqu'au {$until} UTC.");
        break;

    case 'premium:revoke':
        $user = $findUser($positional[0] ?? null);
        (new PremiumService())->revoke((int) $user['id']);
        $out("Premium retiré pour {$user['username']}.");
        break;

    case 'gamification:recheck':
        // Après avoir abaissé un seuil de badge : php bin/console gamification:recheck [email]
        $service = new GamificationService();
        $ids = isset($positional[0])
            ? [(int) $findUser($positional[0])['id']]
            : array_map('intval', array_column(Database::fetchAll("SELECT id FROM users WHERE status = 'active'"), 'id'));
        $unlocked = 0;
        foreach ($ids as $id) {
            $unlocked += count($service->recheckBadges($id));
        }
        $out(count($ids) . " utilisateur(s) vérifié(s), {$unlocked} badge(s) débloqué(s).");
        break;

    case 'source:add':
        // php bin/console source:add agence-dupont "Agence Dupont" partner [--contact=internal|external] [--auto-publish] [--attribution="…"] [--website=https://…] [--logo=https://…]
        [$slug, $name, $kind] = $positional + [null, null, null];
        if (!$slug || !$name || !in_array($kind, ['partner', 'import'], true) || !preg_match('/^[a-z0-9-]{2,60}$/', $slug)) {
            $fail('Usage : php bin/console source:add <slug> <nom> <partner|import> [--contact=internal|external] [--auto-publish] [--attribution=…]');
        }
        $contact = (string) ($options['contact'] ?? ($kind === 'import' ? 'external' : 'internal'));
        Database::execute(
            'INSERT INTO content_sources (slug, name, kind, website_url, logo_url, attribution, contact_mode, auto_publish, created_at)
             VALUES (:slug, :name, :kind, :web, :logo, :attr, :contact, :auto, :d)
             ON DUPLICATE KEY UPDATE name = :name2, kind = :kind2, website_url = :web2, logo_url = :logo2, attribution = :attr2,
                                     contact_mode = :contact2, auto_publish = :auto2',
            [
                'slug' => $slug, 'name' => $name, 'kind' => $kind, 'web' => $options['website'] ?? null, 'logo' => $options['logo'] ?? null,
                'attr' => $options['attribution'] ?? null, 'contact' => $contact, 'auto' => isset($options['auto-publish']) ? 1 : 0, 'd' => gmdate('Y-m-d H:i:s'),
                'name2' => $name, 'kind2' => $kind, 'web2' => $options['website'] ?? null, 'logo2' => $options['logo'] ?? null,
                'attr2' => $options['attribution'] ?? null, 'contact2' => $contact, 'auto2' => isset($options['auto-publish']) ? 1 : 0,
            ],
        );
        $out("Source {$slug} enregistrée (contact : {$contact}, publication " . (isset($options['auto-publish']) ? 'automatique' : 'après validation') . ').');
        break;

    case 'import:run':
    case 'import:all':
        // import:all ne lance que les sources « dues » (fréquence « every » de config/imports.php) ; --force les lance toutes
        $slugs = match (true) {
            $command === 'import:run' => [$positional[0] ?? $fail('Usage : php bin/console import:run <slug>')],
            isset($options['force'])  => array_keys(array_filter((array) Config::get('imports.sources', []), static fn ($c) => ($c['enabled'] ?? true) !== false)),
            default                   => ImportRunner::due(),
        };
        $exit = 0;
        foreach ($slugs as $slug) {
            try {
                $r = (new ImportRunner())->run($slug);
                $out(sprintf('%s : %s — %d reçus, %d créés, %d mis à jour, %d inchangés, %d dépubliés, %d erreurs',
                    $slug, $r['status'], $r['fetched'], $r['created'], $r['updated'], $r['unchanged'], $r['unpublished'], $r['errors']));
                foreach ($r['messages'] as $m) {
                    $out('   · ' . $m);
                }
                $exit = $r['status'] === 'failed' ? 1 : $exit;
            } catch (Throwable $e) {
                fwrite(STDERR, "{$slug} : {$e->getMessage()}\n");
                $exit = 1;
            }
        }
        exit($exit);

    case 'import:status':
        foreach ((array) Config::get('imports.sources', []) as $slug => $config) {
            $r = Database::fetch(
                'SELECT r.* FROM import_runs r JOIN content_sources s ON s.id = r.source_id WHERE s.slug = :s ORDER BY r.id DESC LIMIT 1', ['s' => $slug],
            );
            $out(sprintf('%-28s %-8s toutes les %3d min  %s', $slug, ($config['enabled'] ?? true) === false ? 'off' : $config['target'], (int) ($config['every'] ?? 60),
                $r ? "{$r['started_at']} UTC · {$r['status']} · {$r['fetched']} reçus, {$r['created']} créés, {$r['updated']} maj, {$r['unpublished']} dépubliés, {$r['errors']} erreurs" : 'jamais lancé'));
        }
        break;

    case 'import:preview':
        // Vérifier une nouvelle source avant de l'activer : rien n'est écrit en base
        $slug = $positional[0] ?? $fail('Usage : php bin/console import:preview <slug> [nombre]');
        $config = Config::get('imports.sources.' . $slug) ?? $fail("Source non configurée : {$slug}");
        $limit = max(1, (int) ($positional[1] ?? 3));
        $n = 0;
        foreach ((new $config['importer']())->fetch(($config['options'] ?? []) + ['_source' => $slug]) as $item) {
            $out(json_encode($item, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
            if (++$n >= $limit) {
                break;
            }
        }
        $out("{$n} élément(s) affiché(s).");
        break;

    case 'jobs:send-applications':
        $r = (new \App\Modules\Jobs\ApplicationDispatcher())->dispatch();
        $out("Candidatures transmises : {$r['sent']}, en échec : {$r['failed']}");
        break;

    case 'jobs:maintenance':
        // Archive les offres expirées et supprime les documents périmés (RGPD)
        $out('Offres archivées : ' . (new \App\Modules\Jobs\JobRepository())->archiveExpired());
        $out('Documents supprimés : ' . (new \App\Content\Documents\DocumentStore())->purge());
        break;

    case 'jobs:seed-demo':
        $cat = array_column(Database::fetchAll('SELECT id, slug FROM job_categories'), 'id', 'slug');
        $demo = [
            ['tech', 'cdi', 'hybrid', 'Développeur·se iOS SwiftUI', 'Studio Volcan · Démo', 'Clermont-Ferrand', 3800000, 4500000, 'year',
             "Conception d'interfaces iOS, SwiftUI, tests et collaboration produit.",
             "Conception d'interfaces iOS, SwiftUI, tests et collaboration produit. Tu rejoindras une équipe locale et participeras à des projets variés. Cette description est fictive et sert uniquement à tester le parcours de candidature."],
            ['communication', 'cdd', 'onsite', 'Chargé·e de communication', 'Maison des Puys · Démo', 'Chamalières', 2800000, 3200000, 'year',
             'Réseaux sociaux, communication événementielle et création de contenus.', 'Poste fictif de démonstration.'],
            ['education', 'alternance', 'hybrid', 'Alternance marketing digital', 'Auvergne Campus · Démo', 'Clermont-Ferrand', null, null, null,
             'Campagnes numériques, analyse de trafic et gestion de projets.', 'Alternance fictive de démonstration.'],
            ['tech', 'cdi', 'remote', 'Développeur·se backend PHP', 'Puy Tech · Démo', 'Clermont-Ferrand', 4000000, 5000000, 'year',
             'API, MySQL et performance.', 'Poste fictif de démonstration.'],
        ];
        Database::execute("DELETE FROM job_offers WHERE source_id = 1 AND external_id LIKE 'demo-%'");
        foreach ($demo as $i => [$c, $contract, $mode, $title, $company, $city, $min, $max, $period, $summary, $desc]) {
            $now = gmdate('Y-m-d H:i:s', time() - $i * 7200);
            $id = Database::insert(
                'INSERT INTO job_offers (uid, source_id, external_id, category_id, contract, work_mode, title, company_name, summary, description,
                        missions, profile, city, salary_min_cents, salary_max_cents, salary_period, salary_label, badge_label, image_caption, notice,
                        cover_letter_mode, status, published_at, created_at, updated_at)
                 VALUES (:uid, 1, :ext, :cat, :contract, :mode, :title, :company, :summary, :descr, :missions, :profile, :city, :min, :max,
                         :period, :slabel, \'DÉMO\', \'Découvre l\'\'entreprise\', :notice, \'optional\', \'published\', :p, :c, :u)',
                [
                    'uid' => \App\Security\Crypto::uuid4(), 'ext' => 'demo-' . ($i + 1), 'cat' => $cat[$c], 'contract' => $contract, 'mode' => $mode,
                    'title' => $title, 'company' => $company, 'summary' => $summary, 'descr' => $desc,
                    'missions' => json_encode(["Participer aux projets de l'équipe", 'Collaborer avec les différents interlocuteurs', "Contribuer à l'amélioration continue"], JSON_UNESCAPED_UNICODE),
                    'profile' => 'Autonomie, esprit d\'équipe, curiosité et motivation. Les critères exacts seront précisés dans les annonces réelles.',
                    'city' => $city, 'min' => $min, 'max' => $max, 'period' => $period, 'slabel' => $min === null ? 'Selon grille alternance' : null,
